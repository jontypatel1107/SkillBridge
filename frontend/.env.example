# Leave both unset in development. The app auto-detects the backend host from
# the Expo/Metro bundle URL and, as a fallback, scans your LAN for a server on
# the default port (see src/config/serverUrl.ts) — so it keeps working when
# your PC's IP changes between WiFi networks.
# Only set these when the backend is NOT running on the same machine as Metro
# (e.g. a fixed remote server).
# EXPO_PUBLIC_API_URL=http://YOUR_IP:5000/api
# EXPO_PUBLIC_SOCKET_URL=http://YOUR_IP:5000