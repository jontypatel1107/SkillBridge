NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/skillbridge

JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CLIENT_ORIGIN=http://localhost:19006

# Optional — only required for /api/ai/* routes (roadmap generation, chat
# summaries). Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — for sending OTP emails. If not set, emails are logged to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
